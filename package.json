{
  "name": "wms",
  "private": true,
  "scripts": {
    "lint:vale": "vale docs CLAUDE.md AGENTS.md",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:vale && npm run lint:md && npm run lint:links",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint:links": "lychee --offline --no-progress --config lychee.toml docs/*.md docs/foundation docs/patterns",
    "tokens:build": "node sd.config.mjs",
    "tokens:check": "node scripts/tokens-check.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.24.2",
    "style-dictionary": "^5.8.0"
  }
}
